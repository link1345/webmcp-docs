---
const documents = [
  {
    id: "/getting-started",
    title: "Getting started",
    excerpt: "Register webmcp-docs in an Astro page.",
    content: "# Getting started\n\nThis document is exposed through WebMCP.",
  },
  {
    id: "/provider",
    title: "Provider guide",
    excerpt: "Implement search and document retrieval.",
    content: "# Provider guide\n\nA provider implements search() and getDocument().",
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>webmcp-docs Astro example</title>
    <style>
      :root { font-family: system-ui, sans-serif; color-scheme: light dark; }
      body { max-width: 48rem; margin: 0 auto; padding: 3rem 1.5rem; line-height: 1.6; }
      code, pre { font-family: ui-monospace, monospace; }
      #status { padding: .75rem 1rem; border: 1px solid currentColor; border-radius: .5rem; }
      li + li { margin-top: .75rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>webmcp-docs Astro example</h1>
      <p>
        このページを開くと、<code>search_docs</code> と <code>get_doc</code>
        が WebMCP に登録されます。
      </p>
      <p id="status" aria-live="polite">WebMCPを登録中…</p>

      <h2>公開するサンプル文書</h2>
      <ul>
        {documents.map((document) => (
          <li>
            <strong>{document.title}</strong><br />
            <span>{document.id} — {document.excerpt}</span>
          </li>
        ))}
      </ul>
    </main>

    <script id="documents" type="application/json" set:html={JSON.stringify(documents)} is:inline></script>
    <script>
      import { registerDocsWebMcp } from "webmcp-docs";

      type ExampleDocument = {
        id: string;
        title: string;
        excerpt: string;
        content: string;
      };

      const status = document.querySelector<HTMLElement>("#status");
      const documentsElement = document.querySelector("#documents");
      const documents = JSON.parse(documentsElement?.textContent ?? "[]") as ExampleDocument[];
      const registration = await registerDocsWebMcp({
        provider: {
          search(query) {
            const term = query.toLowerCase();
            return documents
              .filter((document) =>
                `${document.title} ${document.excerpt} ${document.content}`
                  .toLowerCase()
                  .includes(term),
              )
              .map(({ id, title, excerpt }) => ({ id, title, excerpt }));
          },
          getDocument(id) {
            const found = documents.find((document) => document.id === id);
            return found
              ? {
                  id: found.id,
                  title: found.title,
                  content: found.content,
                  canonicalUrl: new URL(found.id, window.location.href).href,
                }
              : null;
          },
        },
      });

      if (status) {
        status.textContent =
          registration.status === "registered"
            ? "WebMCP登録済み: search_docs / get_doc"
            : `WebMCPを登録できませんでした: ${registration.status}`;
        status.dataset.registrationStatus = registration.status;
      }
    </script>
  </body>
</html>
